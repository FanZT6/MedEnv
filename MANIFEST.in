include LICENSE NOTICE README.md README_zh.md .env.example .gitignore .gitattributes
recursive-include .github *.yml
recursive-include docs *.md *.json
recursive-include scripts *.py *.sh
recursive-include services *.py
recursive-include tests *.py
recursive-include examples *.py *.sh *.md
recursive-include requirements *.txt
include data/README.md data/dataset_summary.json
