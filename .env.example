# Copy to .env and edit. Use shell syntax; quote paths containing spaces.

# Benchmark
MEDENV_BENCH_ROOT=data/bench

# Doctor: model server and tokenizer must match.
DOCTOR_MODEL_PATH=Qwen/Qwen3-8B
TOKENIZER_PATH=Qwen/Qwen3-8B
DOCTOR_MODEL=doctor_agent
DOCTOR_BASE_URL=http://127.0.0.1:30000/v1
DOCTOR_API_KEY=None
DOCTOR_PORT=30000
DOCTOR_GPUS=0

# Patient and examiner share this model service.
PATIENT_MODEL_PATH=Qwen/Qwen3-8B
RLLM_PATIENT_MODEL=patient_agent
RLLM_PATIENT_BASE_URL=http://127.0.0.1:30001/v1
RLLM_PATIENT_API_KEY=None
PATIENT_PORT=30001
PATIENT_GPUS=1

# Final-diagnosis Judge. Leave JUDGE_MODEL empty for string-containment scoring.
JUDGE_MODEL_PATH=Qwen/Qwen3-8B
JUDGE_MODEL=judge_agent
JUDGE_BASE_URL=http://127.0.0.1:30002/v1
JUDGE_API_KEY=None
JUDGE_PORT=30002
JUDGE_GPUS=2

# Shared vLLM launch settings
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.9

# Clinical retrieval. Index and corpus must have matching row order.
RETRIEVAL_SERVER_URL=http://127.0.0.1:8003
RETRIEVAL_PORT=8003
RETRIEVER_MODEL=intfloat/e5-base-v2
RETRIEVAL_INDEX=data/retrieval/guidelines_index/e5_Flat.index
RETRIEVAL_CORPUS=data/retrieval/guidelines_index/corpus_passages.jsonl
# Empty means CPU; assign an unused GPU to enable CUDA.
RETRIEVAL_GPUS=

# Visual grounding. Model files must be available at this path.
GROUNDING_MODEL_PATH=models/grounding-dino-base
GROUNDING_PORT=30050
GROUNDING_GPUS=
RLLM_GROUNDING_API_URL=http://127.0.0.1:30050/ground
