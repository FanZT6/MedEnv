# Copy to .env and set local paths / endpoints. Shell syntax; quote paths with spaces.
MEDENV_BENCH_ROOT=data/bench
DOCTOR_MODEL_PATH=Qwen/Qwen3-8B
PATIENT_MODEL_PATH=Qwen/Qwen3-8B
JUDGE_MODEL_PATH=Qwen/Qwen3-8B
TOKENIZER_PATH=Qwen/Qwen3-8B
DOCTOR_MODEL=doctor_agent
DOCTOR_BASE_URL=http://127.0.0.1:30000/v1
DOCTOR_API_KEY=None
RLLM_PATIENT_MODEL=patient_agent
RLLM_PATIENT_BASE_URL=http://127.0.0.1:30001/v1
RLLM_PATIENT_API_KEY=None
JUDGE_MODEL=judge_agent
JUDGE_BASE_URL=http://127.0.0.1:30002/v1
JUDGE_API_KEY=None
DOCTOR_GPUS=0
PATIENT_GPUS=1
JUDGE_GPUS=2
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.9
RETRIEVAL_SERVER_URL=http://127.0.0.1:8003
RETRIEVER_MODEL=intfloat/e5-base-v2
